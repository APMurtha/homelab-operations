[Unit]
Description=Poll and advance approved Samwise repository engineering tasks

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/samwise-engineering-v1/checkout/supervisor
ExecStart=/usr/bin/python3 -I -c "import sys,runpy;sys.path.insert(0,'.');runpy.run_path('worker.py',run_name='__main__')" --state %h/.local/state/samwise-engineering-v1
LoadCredential=openai.key:%h/.config/samwise-engineering-v1/openai.key
EnvironmentFile=%h/.config/samwise-engineering-v1/service.env
UnsetEnvironment=SSH_AUTH_SOCK GIT_ASKPASS SSH_ASKPASS
UMask=0077
TimeoutStartSec=15min
TimeoutStopSec=20s
KillMode=control-group
Delegate=yes
TasksMax=256
MemoryMax=2G
CPUQuota=175%
