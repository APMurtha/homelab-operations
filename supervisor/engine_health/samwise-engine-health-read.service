[Unit]
Description=Read fixed stored health results for four media containers

[Service]
Type=oneshot
User=samwise-engine-health
Group=samwise-engine-health
OpenFile=/run/docker.sock:engine
ExecStart=/opt/samwise-engine-health/request
RuntimeDirectory=samwise-engine-health
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
AppArmorProfile=samwise-engine-health-read
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=/run/docker.sock
SystemCallArchitectures=native
SystemCallFilter=~@mount @privileged @debug socket socketpair connect bind listen accept accept4 sendmsg recvmsg sendmmsg recvmmsg io_uring_setup io_uring_enter io_uring_register
LimitCORE=0
TimeoutStartSec=5
MemoryMax=64M
TasksMax=2
StandardOutput=null
StandardError=null
