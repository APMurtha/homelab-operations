#include <tunables/global>
profile samwise-engine-health-read {
  /opt/samwise-engine-health/request rix,
  /usr/bin/python3.12 rix,
  /etc/ld.so.cache r,
  /usr/lib/x86_64-linux-gnu/**.so* mr,
  /lib/x86_64-linux-gnu/**.so* mr,
  /usr/lib/python3.12/ r,
  /usr/lib/python3.12/** mr,
  /usr/lib/locale/** r,
  /usr/share/locale/** r,
  /dev/null rw,
  /dev/urandom r,
  /opt/samwise-engine-health/ r,
  /opt/samwise-engine-health/{acquire,dispatcharr_monitor_fields,dispatcharr_project,ops_protocol}.py r,
  owner /run/samwise-engine-health/ rw,
  owner /run/samwise-engine-health/{batch,.batch-*} rw,
  network unix stream,
}
profile samwise-engine-health-publish {
  /usr/bin/python3.12 rix,
  /etc/ld.so.cache r,
  /usr/lib/x86_64-linux-gnu/**.so* mr,
  /lib/x86_64-linux-gnu/**.so* mr,
  /usr/lib/python3.12/ r,
  /usr/lib/python3.12/** mr,
  /usr/lib/locale/** r,
  /usr/share/locale/** r,
  /dev/null rw,
  /dev/urandom r,
  /etc/{passwd,group,nsswitch.conf} r,
  /opt/samwise-engine-health/ r,
  /opt/samwise-engine-health/{release,dispatcharr_project,ops_protocol}.py r,
  /run/samwise-engine-health/ r,
  /run/samwise-engine-health/batch r,
  /run/samwise-observations/ rw,
  /run/samwise-observations/{backend,gateway,vpn-container,jellyfin,.dispatcharr-*} rw,
  capability dac_read_search,
  deny network,
}
