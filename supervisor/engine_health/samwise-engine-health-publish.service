[Unit]
Description=Publish the four bounded container health projections
Wants=samwise-engine-health-read.service
After=samwise-engine-health-read.service

[Service]
Type=oneshot
User=root
Group=samwise-observe
ExecStart=/usr/bin/python3 -IB /opt/samwise-engine-health/release.py
AppArmorProfile=samwise-engine-health-publish
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
InaccessiblePaths=/run/docker.sock
ReadWritePaths=/run/samwise-observations
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=~@network-io @mount @debug io_uring_setup io_uring_enter io_uring_register
UMask=0027
LimitCORE=0
TimeoutStartSec=4
MemoryMax=64M
TasksMax=2
StandardOutput=null
StandardError=null
