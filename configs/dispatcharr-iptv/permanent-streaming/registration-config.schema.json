{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private current-AIO API credentials and reviewed ACL precondition",
  "type": "object",
  "additionalProperties": false,
  "required": ["username", "password", "expected_network_access_sha256", "jellyfin_peer_ipv4"],
  "properties": {
    "username": {"type": "string", "minLength": 1},
    "password": {"type": "string", "minLength": 1},
    "expected_network_access_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "jellyfin_peer_ipv4": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "format": "ipv4"}}
  }
}
